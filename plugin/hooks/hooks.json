{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tagteam:hub",
            "tool": "hook_brief",
            "input": { "session_id": "${session_id}" },
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tagteam:hub",
            "tool": "hook_stop",
            "input": {
              "session_id": "${session_id}",
              "stop_hook_active": "${stop_hook_active}"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
